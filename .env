# Database
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_pass
POSTGRES_DB=ecommerce
DATABASE_URL=postgresql://ecommerce:ecommerce_pass@postgres:5432/ecommerce

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Service URLs (internal)
CATALOG_SERVICE_URL=http://catalog-service:8001
CART_SERVICE_URL=http://cart-service:8002
ORDER_SERVICE_URL=http://order-service:8003
PAYMENT_SERVICE_URL=http://payment-service:8004
INVENTORY_SERVICE_URL=http://inventory-service:8005
API_GATEWAY_URL=http://api-gateway:8181

# Observability
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# Communication Mode (sync or async)
COMMUNICATION_MODE=sync

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Payment Simulation
PAYMENT_FAILURE_RATE=0.1
PAYMENT_DELAY_MS=100
